# Copy to .env and fill in. Placeholder values only; never commit the real file.

# Login password for the web UI (at least 12 characters). If unset, login always fails (closed).
# The server refuses to start while any value below is still this file's placeholder.
APP_PASSWORD=change-me
# REQUIRED. Long random string, at least 32 characters (generate: openssl rand -hex 32). Encrypts stored secrets
# (OAuth tokens, Morning and AI keys, SSH key). If you lose or change it, stored secrets become unreadable
# and you must reconnect every service.
SECRET_KEY=replace-with-64-hex-chars
# Bearer token for machine endpoints (Authorization: Bearer <token>), at least 32 characters.
# Unset = API-token auth always fails.
API_TOKEN=replace-with-another-random-string
# Public base URL of this app, no trailing slash. OAuth redirect URIs are PUBLIC_URL/api/oauth/<provider>/callback.
PUBLIC_URL=https://invoices.example.com
PORT=3100
# Where the SQLite database lives (the Docker image uses /data).
DATA_DIR=./data
# Optional: set when behind a reverse proxy / Cloudflare Tunnel so the client IP is correct (e.g. 1).
# TRUST_PROXY=1

# Google OAuth client (Gmail API). See docs/SETUP.md.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Dropbox app key (PKCE, no secret needed).
DROPBOX_APP_KEY=your-dropbox-app-key
