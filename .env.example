# Copy to .env and fill in. Placeholder values only; never commit the real file.

# The owner account, created on the first start only (later changes here have no effect: change the password in
# Settings -> My account). Login is ADMIN_EMAIL (default "admin") with APP_PASSWORD (at least 12 characters).
# Set ADMIN_EMAIL to your Google address to also sign in with Google. Friends join by invite link (Settings -> Users).
# The server refuses to start while any value below is still this file's placeholder.
APP_PASSWORD=change-me
# ADMIN_EMAIL=you@gmail.com
# REQUIRED. Long random string, at least 32 characters (generate: openssl rand -hex 32). Encrypts stored secrets
# (OAuth tokens, Morning and AI keys, SSH key). If you lose or change it, stored secrets become unreadable
# and you must reconnect every service.
SECRET_KEY=replace-with-64-hex-chars
# Optional: the owner's bearer token for /api/v1 (Authorization: Bearer <token>), at least 32 characters.
# Every user can also create a personal token in Settings -> My account.
API_TOKEN=replace-with-another-random-string
# Public base URL of this app, no trailing slash. OAuth redirect URIs are PUBLIC_URL/api/oauth/<provider>/callback.
PUBLIC_URL=https://invoices.example.com
PORT=3100
# Where the SQLite databases live (the Docker image uses /data): accounts.db, the owner's app.db, and one
# tenants/<user-id>.db per invited user.
DATA_DIR=./data
# Optional: set when behind a reverse proxy / Cloudflare Tunnel so the client IP is correct (e.g. 1).
# TRUST_PROXY=1

# Only for whoever operates a shared Telegram bot for several instances (docs/SETUP.md, section 6).
# The shared bot's token from BotFather; setting it makes this instance the hub at PUBLIC_URL/relay/v1.
# RELAY_BOT_TOKEN=
# Optional: instances must present this key to register with the hub.
# RELAY_INVITE_KEY=

# Google OAuth client (Gmail API, Google Drive if you file there, and "Sign in with Google"). See docs/SETUP.md.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Dropbox app key (PKCE, no secret needed). Only if you file to Dropbox.
DROPBOX_APP_KEY=your-dropbox-app-key
