  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "dev:ui": "vite",
    "seed:demo": "DATA_DIR=./data-demo tsx scripts/seed-demo.ts",
