{
  "schemaVersion": 1,
  "vendorKey": "bug-holland",
  "displayName": "באג הולנדיטסנטר",
  "match": {
    "senders": [
      "*@bug.co.il"
    ]
  },
  "fields": {
    "currency": {
      "kind": "const",
      "value": "ILS"
    },
    "vendorName": {
      "kind": "const",
      "value": "באג הולנדיטסנטר"
    },
    "docType": {
      "kind": "const",
      "value": "tax_invoice_receipt"
    },
    "issueDate": {
      "kind": "regex",
      "pattern": "(\\d{2}/\\d{2}/\\d{4})",
      "parse": "date",
      "dateFormat": "DD/MM/YYYY"
    },
    "total": {
      "kind": "regex",
      "pattern": "סה[\"״”“׳']כ\\s+(\\d+(?:[,.]\\d+)*)",
      "parse": "amount"
    }
  },
  "description": "רכישת ציוד"
}
