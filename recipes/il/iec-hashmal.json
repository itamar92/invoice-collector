      "pattern": "(?:סה[\"״”“׳']?כ כולל מע[\"״”“׳']?מ לתקופת חשבון|הסכום לתשלום בש[\"״”“׳']?ח|סכום לתשלום)\\s*([\\d,.]+)",
      "parse": "amount"
    }
  },
