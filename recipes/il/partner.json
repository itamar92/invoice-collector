{
  "schemaVersion": 1,
  "vendorKey": "partner",
  "displayName": "פרטנר",
  "match": {
    "senders": [
      "thankyou@partner.net.il"
    ]
  },
  "fields": {
    "currency": {
      "kind": "const",
      "value": "ILS"
    },
    "vendorName": {
      "kind": "const",
      "value": "פרטנר תקשורת בע\"מ"
    },
    "vendorTaxId": {
      "kind": "const",
      "value": "557604147"
    },
    "docType": {
      "kind": "const",
      "value": "tax_invoice_receipt"
    },
    "docNumber": {
      "kind": "regex",
      "pattern": "מס' חשבון תקופתי:\\s*(\\d{6,})",
      "parse": "text"
    },
    "issueDate": {
      "kind": "regex",
      "pattern": "תאריך עריכת חשבון:\\s*(\\d{2}/\\d{2}/\\d{2})",
      "parse": "date",
      "dateFormat": "DD/MM/YY"
    },
    "total": {
      "kind": "regex",
      "pattern": "סה\"כ כולל מע\"מ\\s*:\\s*(\\d+\\s*\\.\\s*-?[\\d,]+)",
      "parse": "amount",
      "mirrored": true
    },
    "vat": {
      "kind": "regex",
      "pattern": "\\|\\s*מע\"מ\\s*:\\s*(\\d+\\s*\\.\\s*-?[\\d,]+)",
      "parse": "amount",
      "mirrored": true
    },
    "net": {
      "kind": "regex",
      "pattern": "סה\"כ לפני מע\"מ\\s*:\\s*(\\d+\\s*\\.\\s*-?[\\d,]+)",
      "parse": "amount",
      "mirrored": true
    }
  },
  "description": "חשבון אינטרנט חודש {issueMonth}"
}
