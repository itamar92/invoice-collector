{
  "schemaVersion": 1,
  "vendorKey": "liveplay",
  "displayName": "לייב פליי",
  "match": {
    "senders": [
      "*@liveplay.co.il"
    ]
  },
  "fields": {
    "currency": {
      "kind": "const",
      "value": "ILS"
    },
    "vendorName": {
      "kind": "const",
      "value": "לייב פליי בע\"מ"
    },
    "docType": {
      "kind": "regex",
      "pattern": "(חשבונית מס\\s*/?\\s*קבלה|חשבונית מס|קבלה)",
      "parse": "docType"
    },
    "issueDate": {
      "kind": "regex",
      "pattern": "\\b(\\d{1,2}/\\d{1,2}/\\d{4})\\b",
      "parse": "date",
      "dateFormat": "DD/MM/YYYY"
    },
    "total": {
      "kind": "regex",
      "pattern": "סה[\"״”“׳']כ:\\s*([0-9,]+(?:\\.\\d{2})?)\\s*₪",
      "parse": "amount"
    }
  },
  "description": "צמידי לד לאירועים"
}
